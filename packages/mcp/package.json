{
  "name": "@configshell/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP interface — read-only, deterministic tools over the ConfigShell catalog and installer, built on the official MCP TypeScript SDK.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "configshell-mcp": "./src/bin.ts"
  },
  "scripts": {
    "start": "tsx src/bin.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@configshell/catalog": "*",
    "@configshell/installer": "*",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@configshell/test-utils": "*",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
