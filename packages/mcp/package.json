{
  "name": "@configshell/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP interface — read-only, deterministic tools over the ConfigShell catalog and installer. Plans and validates; never executes.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "configshell-mcp": "./src/bin.ts"
  },
  "scripts": {
    "start": "tsx src/bin.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@configshell/catalog": "workspace:*",
    "@configshell/installer": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
