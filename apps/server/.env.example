# -----------------------------------------------------------------------------
# apps/server — environment template
#
# Copy this file to `apps/server/.env` and adjust as needed:
#
#     cp apps/server/.env.example apps/server/.env
#
# `.env` is git-ignored; this template is committed. Never put a real secret,
# API key, token, or password in this file.
#
# Every variable below is OPTIONAL — the server starts with no `.env` at all.
# Variables are read and validated in `apps/server/config/env.js`; an invalid
# value fails startup with an explanatory error rather than being ignored.
# -----------------------------------------------------------------------------

# Port the API server listens on.
# Used by: apps/server. Optional. Default: 3000. Must be an integer 1–65535.
#
# NOTE: the web dev server also defaults to port 3000, so change one of them if
# you run both at once (see docs/development.md).
PORT=4000

# Run mode. Used by: apps/server. Optional. Default: development.
# One of: development | test | production.
NODE_ENV=development

# -----------------------------------------------------------------------------
# Not yet used — do not add these until the feature that reads them exists.
#
# The AI, MCP, and local-agent layers are unimplemented (see ROADMAP.md), so the
# repository intentionally declares no AI provider keys, database URLs, or
# authentication secrets. If you are adding a feature that needs one, add it
# here with a placeholder value and document it in the same pull request.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Remote MCP
# -----------------------------------------------------------------------------

# Where the MCP endpoint is mounted. Used by: apps/server. Optional.
# Default: /mcp — the path both Claude and ChatGPT use in their own examples.
# Must be absolute, with no trailing slash, and must not collide with /api or
# /health.
MCP_PATH=/mcp

# The canonical public origin this deployment is reachable at.
# Used by: apps/server. Optional locally; SET IT IN PRODUCTION.
# Default: http://localhost:<PORT>.
#
# This is used only to DERIVE AND DISPLAY the public MCP URL
# (${PUBLIC_BASE_URL}${MCP_PATH}) — nothing routes on it, so a wrong value
# misreports a URL rather than breaking the server.
#
# Must be https for any non-localhost host, because remote MCP hosts require it.
#
# Deliberately NOT derived from VERCEL_URL: that changes on every deployment, so
# a user who copied it into Claude or ChatGPT would find their connector broken
# by the next push. Point it at your stable domain.
PUBLIC_BASE_URL=http://localhost:3000
