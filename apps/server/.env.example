# Copy to apps/server/.env and adjust. Every variable is optional — the value
# shown is the default the server falls back to (see src/config/env.ts), so an
# empty file equals "run with defaults". For the Docker deployment these are
# passed through Compose instead; see docs/deployment.md.
#
# Never commit a real .env file; .env files are git-ignored.
PORT=3000
NODE_ENV=development
MCP_PATH=/mcp
PUBLIC_BASE_URL=http://localhost:3000