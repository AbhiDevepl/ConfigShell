{
  "name": "linux-app-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Linux App Platform — AI-native Linux software discovery and management platform",
  "type": "module",
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "eslint .",
    "typecheck": "pnpm --filter web typecheck && pnpm --filter @linux-app-platform/catalog typecheck",
    "test": "pnpm --filter @linux-app-platform/catalog test && pnpm --filter server test",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.46.0"
  }
}
