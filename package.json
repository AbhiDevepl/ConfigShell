{
  "name": "linux-app-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Linux App Platform — AI-native Linux software discovery and management platform",
  "type": "module",
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter ./apps/web dev",
    "build": "pnpm --filter ./apps/web build",
    "start": "pnpm --filter ./apps/web start",
    "lint": "pnpm --filter ./apps/web lint",
    "test": "pnpm --filter ./apps/server test"
  },
