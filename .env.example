# =============================================================================
# configshell — environment template
#
# Copy to `.env` (git-ignored) for Docker Compose and the API server. Every
# variable below has a safe default; this file documents what they do and the
# values the Docker deployment reads. See docs/deployment.md for the full story.
#
#   cp .env.example .env
#   docker compose up -d
# =============================================================================

# --- API server (apps/server/src/config/env.ts) -----------------------------If the overlay stays, nginx runs as root (base-image default). Harden it?
Harden it
Switch to nginxinc/nginx-unprivileged, which runs as UID 101 and listens on 8080. Requires changing the listen directive, the healthcheck, the compose port mapping and the cap_add list — four small edits, all deployment config, no app code.
Leave as is
nginx master runs as root but workers drop to the nginx user, and compose already applies read_only, cap_drop ALL and no-new-privileges. This is the stock posture for the official image and is widely accepted.
Moot — deleting the overlay
Pick this if you chose to delete the overlay above; there is then no nginx image to harden.
Other

# Port the Express process listens on inside its container. Defaults to 3000.
# Change the host-side mapping with API_PORT instead of this.
PORT=3000

# development | test | production. The bundled server runs `production`.
NODE_ENV=production

# Absolute URL this deployment is publicly reachable at (used to derive and
# display the public MCP URL; no traffic routes on it). Must be https unless
# it is a localhost origin, e.g. https://configshell.example.com.
PUBLIC_BASE_URL=http://localhost:3000

# Path the Streamable HTTP MCP endpoint is mounted at, starting with / and with
# no trailing slash. Cannot collide with /api or /health. When the nginx
# overlay (compose.web.yml) is used, nginx must proxy the same path.
MCP_PATH=/mcp

# --- Docker Compose (host-side port mapping) --------------------------------

# Host port the stack is published on. Default mode: API + web on one port.
API_PORT=3000
# Host port for the nginx web tier in reverse-proxy mode (compose.web.yml).
WEB_PORT=8080