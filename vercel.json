{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "apps/server/vercel.js": {
      "includeFiles": "apps/server/**,packages/catalog/**,packages/installer/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/apps/server/vercel.js" },
    { "source": "/health", "destination": "/apps/server/vercel.js" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
